#include <iostream>
class Solution {
public:
    string removeOuterParentheses(string s) {
        int depth=0;
        string result="";

        for(int c=0; c<s.length();c++){
            char ch=s[c];
            if (ch=='('){
                if(depth>0){
                    result+=ch;
                }
                depth++;
            }
            else{
                depth--;
                if (ch==')'){
                    if(depth>0){
                        result+=ch;
                    }
                }
            }
        }

        return result;
    }

};
